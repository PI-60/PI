<section class="formulario">
    <H1>Ministrantes</H1> 
         <div id="pesquisa">
            <label for="nome"></label>
            <input type="text" id="nome" name="nome" placeholder="Pesquisar">
         </div>


                   <!-- mostrar participantes no banco -->
         <div id="listap">
        {{#each ministrante}} 

    <div class="linha-ministrante">

        <span class="nome-ministrante">
            {{nome}}
        </span>

        <span class="telefone-ministrante">
            {{telefone}}
        </span>

        <span class="email-ministrante">
            {{email}}  ///MUDAR PARA TELEFONE
        </span>

    </div>

{{/each}}
          <p id="semresul" style="display:none;
          ">Nenhum ministrante encontrado.</p>

     </div>
</section>

</main>