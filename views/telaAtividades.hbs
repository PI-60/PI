<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Atividades &middot; IFSC 60+</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,900&family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/styleAtividades.css">
  <link rel="stylesheet" href="/css/styleDescricao.css">

  <!-- defer foi usado pra adiar o js porque o html nao estava finalizado e o js tentava buscar o campopesquisae o botao -->
  <script src="/js/atividades.js" defer></script>
  <script src="/js/descricao.js" defer></script>

</head>

<body class="atividades-page">

  <!-- SIDE BAR -->
  <div class="app-shell">

    <aside class="sidebar">
      <div class="sidebar-top">
        <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Abrir menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <span class="sidebar-brand">IFSC60+</span>
      </div>

      <nav class="sidebar-nav">
        <a href="/inicioLogado">Início</a>
        <a href="/dashboard">Dashboard</a>
        <a href="/atividades" class="active">Atividades</a>
        <a href="/participantes">Participantes</a>
        <a href="/calendario">Calendário</a>
        <a href="/frequencia">Frequência</a>
        <a href="/galeria">Galeria</a>
      </nav>

      <div class="sidebar-footer">
        <img src="/assets/60.webp" alt="Logo IFSC 60+">
      </div>
    </aside>

    <main class="main-content">
      <div class="main-topbar">
        <button type="button" class="btn-exit" id="exitBtn">
          Exit
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <path d="M16 17l5-5-5-5" />
            <path d="M21 12H9" />
          </svg>
        </button>
      </div>


      <div class="content-header">
        <div>
          <h1>Atividades</h1>
          <p class="subtitle">Oficinas, Eventos e Saídas Técnicas</p>
        </div>

        <!-- BOTAO PARA CADASTA UMA NOVA ATIVIDADE -->
        <button type="button" class="btn-nova">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
            stroke-linecap="round">
            <path d="M12 5v14M5 12h14" />
          </svg>
          NOVA ATIVIDADE
        </button>
      </div>


      <!-- BUSCAR ATIVIDADE PELO TITULO -->
      <div class="busca-atividade">
        <input type="text" id="titulo" name="titulo" placeholder="Buscar atividade...">
      </div>

      <!-- se nao encontrar -->
      <p id="semresul" style="display: none;">
        Nenhuma atividade encontrada.
      </p>

      <!-- LISTAGEM DAS ATIVIDADES -->
      <div class="atividades-grid">

        {{#each atividades}}
        <div class="card-atividade cor-{{this.cor}}" data-id="{{this.idOficina}}"> 
          <!--data-id="{{this.idOficina}}"> para que cada card possua o id da ofiicina para ser usado no modal -->
          <div class="card-top">
            <div class="card-actions">

              <!-- BOTÃO EDITAR -->

              <form action="/atividades/{{idOficina}}/editar" method="get" class="editar">
                <button type="submit" class="icon-btn edit" aria-label="Editar atividade">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z" />
                  </svg>
                </button>
              </form>


              <!-- BOTÃO EXCLUIR -->
              <form action="/atividades/{{idOficina}}/excluir" method="post" class="excluir">
                <button type="submit" class="icon-btn delete" aria-label="Excluir atividade">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18" />
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                    <path d="M10 11v6" />
                    <path d="M14 11v6" />
                  </svg>
                </button>
              </form>

            </div>
          </div>

          <!-- infos -->
          <h3>{{this.titulo}}</h3>
          <p class="tipo">{{this.tipo}}</p>

          <div class="card-meta">
            <span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path d="M16 2v4" />
                <path d="M8 2v4" />
                <path d="M3 10h18" />
              </svg>
              {{this.dt_inicio}}
            </span>

            <span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              {{this.local}}
            </span>

          </div>

        </div>
        {{/each}}


      </div>

      <!-- modal -->
      <dialog id="modalOficina" class="modal-oficina">

        <button type="button" id="fecharModal">
          X
        </button>

        <h2 id="nomeOficina"></h2>
        <p id="tipoOficina"></p>

        <p>
          <strong>Descrição:</strong>
          <span id="descricaoOficina"></span>
        </p>

        <p>
          <strong>Data de início:</strong>
          <span id="dataiOficina"></span>
        </p>
        <p>
          <strong>Data final:</strong>
          <span id="datafOficina"></span>
        </p>


        <p>
          <strong>Local:</strong>
          <span id="localOficina"></span>
        </p>


        <p>
          <strong>Ministrante:</strong>
          <span id="ministrante"></span>
        </p>

        <div>
          <strong>Bolsistas:</strong>
          <ul id="bolsistas"></ul>
        </div>

      </dialog>



    </main>
  </div>

</body>

</html>