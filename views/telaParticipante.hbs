<link rel="stylesheet" href="/css/styleParticipante.css">
<script src="/js/listaParticipante.js" defer></script>
<main class="participantes-page">

  <!--  video ref https://www.youtube.com/watch?v=dI8wiEs8cag -->

  <aside class="sidebar">

    <div class="sidebar-top">
      <span class="sidebar-brand">IFSC60+</span>
    </div>

    <nav class="sidebar-nav">
      <a href="/inicioLogado">
        Início
      </a>
      <a href="/atividades">
        Atividades
      </a>
      <a href="/participantes">
        Participantes
      </a>
      <a href="/frequencia">
        Frequência
      </a>

      <a href="/usuarios" class="ativo">Usuários</a>
    </nav>

    <div class="sidebar-footer">
      <img src="./assets/60.webp" alt="Logo IFSC 60+">
    </div>

  </aside>

  <div id="mensagem" class="mensagem" hidden></div>

  <section class="formulario">
    <H1>Participantes</H1>
    <div class="linha-pesquisa">
      <div id="pesquisa">
        <input type="text" id="nome" name="nome" placeholder="Pesquisar">
      </div>

      <button type="button" class="botao-freq" id="bntfrequencia">
        FREQUÊNCIA
      </button>

      <button type="button" class="botao-imprimir" id="btnImprimir">
        IMPRIMIR LISTA
      </button>
    </div>
    <!--só aparece na impressao-->
    <div class="cabecalho-impressao">
      <h2>Lista de Participantes</h2>

      <div class="titulos-colunas">
        <span>Nome</span>
        <span>Telefone</span>
        <span>CPF</span>
      </div>
    </div>

    <!-- mostrar participantes no banco -->
    <div id="listap">
      {{#each participantes}}

      <div class="linha-participante">

        <span class="nome-participante">
          {{nome}}
        </span>

        <span class="telefone-participante">
          {{telefone}}
        </span>

        <span class="cpf-participante">
          {{CPF}}
        </span>

        <div class="acoes-participante">
          {{#if ../ehBolsista}}

          <span class="acao-participante-bloqueada" data-tooltip="Você não tem permissão para editar participantes">

            <button type="button" class="btn-acao btn-editar editar-bloqueado" disabled aria-disabled="true"
              aria-label="Editar participante bloqueado">

              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
              </svg>

            </button>

          </span>

          {{else}}

          <a href="/cadastro?id={{idParticipante}}" class="btn-acao btn-editar" title="Editar participante"
            aria-label="Editar {{nome}}">

            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
            </svg>

          </a>

          {{/if}}

          {{#if ../ehBolsista}}

          <span class="acao-participante-bloqueada" data-tooltip="Você não tem permissão para excluir participantes">

            <button type="button" class="btn-acao btn-excluir excluir-bloqueado" disabled aria-disabled="true"
              aria-label="Excluir participante bloqueado">

              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18" />
                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 a2 2v2" />
                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                <path d="M10 11v6" />
                <path d="M14 11v6" />
              </svg>

            </button>

          </span>

          {{else}}

          <form action="/participantes/{{idParticipante}}/excluir" method="post" class="form-excluir"
            data-nome="{{nome}}">

            <button type="submit" class="btn-acao btn-excluir" title="Excluir participante"
              aria-label="Excluir {{nome}}">

              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18" />
                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 a2 2v2" />
                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 a-2-2L5 6" />
                <path d="M10 11v6" />
                <path d="M14 11v6" />
              </svg>

            </button>

          </form>

          {{/if}}
        </div>

      </div>

      {{/each}}
      <p id="semresul" style="display:none;
          ">Nenhum participante encontrado.</p>

    </div>
    <div class="paginacao">
      <span id="contador-participantes">
        Carregando participantes...
      </span>

      <div id="botoes-paginacao"></div>
    </div>

  </section>



</main>