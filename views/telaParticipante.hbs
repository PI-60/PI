 <script src="/js/listaParticipante.js" defer></script>
<main class="participantes-page">

<!--  video ref https://www.youtube.com/watch?v=dI8wiEs8cag -->

<aside class="sidebar">

    <div class="sidebar-top">
      <span class="sidebar-brand">IFSC60+</span>
    </div>  

    <nav class="sidebar-nav">
      <a href="/inicioLogado">
        Início
      </a>
      <a href="/dashboard">
        Dashboard
      </a>
      <a href="/atividades">
