<!-- LADO ESQUERDO DA FOTO: Conteúdo complementar/Banner -->
<aside>
    <img class="banner" src="./assets/v332_147.png" alt="banner">
</aside>

<!-- Barra colorida com as cores da logo, separando as duas metades -->
<div class="color-bar"></div>

<!-- LADO DIREITO DA FOTO: Fluxo principal da página -->
<main>
    <section>
        <header>
            <img class="logo" src="./assets/60.webp" alt="logo">
        </header>

        <form id="loginForm" action="/login" method="POST">
            <div>
                <!-- Input de E-mail/Usuário -->
                <p class="field-group">
                    <input type="email" id="username" name="email" placeholder="E-mail" aria-label="E-mail" required>
                </p>

                <!-- Input senha com o ícone do olho e estilo de camada (z-index) forçado -->
                <p class="field-group" style="position: relative; display: flex; align-items: center;">
                    <input type="password" id="password" name="senha" placeholder="Senha" aria-label="Senha" required style="width: 100%; padding-right: 45px;">
                    
                    <button type="button" id="toggleBtn" aria-label="Mostrar ou ocultar senha" style="position: absolute; right: 8px; z-index: 999; background: transparent; border: none; cursor: pointer; padding: 5px; display: flex; align-items: center; justify-content: center;">
                        <svg id="eyeIcon" viewBox="0 0 24 24" style="width: 22px; height: 22px; fill: #666; pointer-events: none;">
                            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                        </svg>
                    </button>
                </p>

                <!-- Opções de recuperação -->
                <p class="options-row">
                    <a href="/recuperar-senha">Esqueceu sua senha?</a>
                </p>

                <!-- Mensagem de erro retornada pelo Node.js -->
                {{#if erro}}
                    <p class="text-danger" style="color: red;">{{erro}}</p>
                {{/if}}

                <!-- Botão de submissão do formulário -->
                <button type="submit" class="button btn-login" id="loginButton">
                    Entrar
                </button>
            </div>
        </form>
    </section>
</main>

<!-- SCRIPT DIRETO NA VIEW PARA GARANTIR EXECUÇÃO -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('toggleBtn');
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eyeIcon');

    if (toggleBtn && passwordInput && eyeIcon) {
      toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        
        const isPassword = passwordInput.getAttribute('type') === 'password';

        if (isPassword) {
          passwordInput.setAttribute('type', 'text');
          // Ícone Olho Aberto
          eyeIcon.innerHTML = `<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>`;
        } else {
          passwordInput.setAttribute('type', 'password');
          // Ícone Olho Riscado
          eyeIcon.innerHTML = `<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/><line x1="3" y1="3" x2="21" y2="21" stroke="#666" stroke-width="2.5" stroke-linecap="round"/>`;
        }
      });
    }
  });
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('toggleBtn');
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eyeIcon');

    // Ícone 1: Olho normal (senha oculta)
    const iconEyeOpen = `<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>`;
    
    // Ícone 2: Olho risco/fechado (senha visível)
    const iconEyeClosed = `<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/><line x1="3" y1="3" x2="21" y2="21" stroke="#666" stroke-width="2.5" stroke-linecap="round"/>`;

    if (toggleBtn && passwordInput && eyeIcon) {
      toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();

        if (passwordInput.type === 'password') {
          passwordInput.type = 'text';
          eyeIcon.innerHTML = iconEyeClosed;
        } else {
          passwordInput.type = 'password';
          eyeIcon.innerHTML = iconEyeOpen;
        }
      });
    }
  });
</script>