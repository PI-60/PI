
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/styleGaleria.css">
<script src="/js/galeria.js" defer></script>


<!-- SIDE BAR -->
  <div class="app-shell">

    <aside class="sidebar">
      <div class="sidebar-top">
        <span class="sidebar-brand">IFSC60+</span>
      </div>

      <nav class="sidebar-nav">
        <a href="/inicioLogado">Início</a>
        <a href="/atividades" class="active">Atividades</a>
        <a href="/participantes">Participantes</a>
        <a href="/frequencia">Frequência</a>
        <a href="/usuarios" class="ativo">Usuários</a>
           <a href="/galeria" class="ativo">Galeria</a>
      </nav>

      <div class="sidebar-footer">
        <img src="/assets/60.webp" alt="Logo IFSC 60+">
      </div>
    </aside>

        

<main class="pagina-galeria">
        <div>
            <h1>Galeria de imagens</h1>
        </div>

        <button id="adicionarImagem">
            + Adicionar imagem
        </button>

        <input
            type="file"
            id="inputImagem"
            accept="image/*"
            hidden
        >
        <br>

    <section class="galeria" id="galeria">

    {{#each imagens}}

        <div class="imagem-item">
            <img 
                src="{{caminho}}" 
                alt="Imagem da galeria"
                   data-data="{{data_upload}}"
            >
        </div>

    {{/each}}

</section>

<!--  modal -->
<dialog id="modalImagem" class="modal-imagem">

    <button type="button" id="fecharModal" class="fechar-modal">
        &times;
    </button>

    <img id="imagemAmpliada" src="" alt="Imagem ampliada">
    <div class="informacoes-imagem">

        <h2>Informações da imagem</h2>

        <p>
            <strong>Data de adição:</strong>
            <span id="dataImagem"></span>
        </p>

        <p>
            <strong>Horário:</strong>
            <span id="horaImagem"></span>
        </p>

    </div>

</dialog>
</main>