<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,900&family=Manrope:wght@400;500;600;700;800&display=swap"
  rel="stylesheet">

<link rel="stylesheet" href="./css/styleHeader.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="topbar"></div>

<header>
  <div class="site-header">
    <div class="container nav-inner">

      <div class="brand">
        <span class="a">IFSC</span>
        <span class="b">60+</span>
      </div>
      
        <div class="usuario-logado">
<div class="usuario-container">

    <button
        class="bolinha"
        id="botaoUsuario"
        type="button"
        aria-label="Informações da conta">

        {{inicialUsuario}}
    </button>

    <div class="menu-usuario" id="menuUsuario">

        <strong>
            {{#if usuario}}
                {{usuario.nome}}
            {{else}}
                Usuário
            {{/if}}
        </strong>

        <span>
            {{#if usuario}}
                {{usuario.email}}
            {{else}}
                usuario@email.com
            {{/if}}
        </span>

        <div class="separador"></div>

        <button
            class="opcao-menu"
            id="trocarConta"
            type="button">

            <i class="bi bi-arrow-left-right"></i>
            <span>Trocar de conta</span>
        </button>

            <button
            class="opcao-menu"
            id="desistencia"
            type="button">

            <i class="bi bi-arrow-left-right"></i>
            <span>Desistir do cargo</span>
        </button>

      </div>
    </div>

    <div class="notificacoes-container" id="notificacoesContainer">
        <button
            class="btn-sino"
            id="botaoNotificacoes"
            type="button"
            aria-label="Notificações">

            <i class="bi bi-bell"></i>
            <span class="badge-notificacao" id="badgeNotificacao" hidden>0</span>
        </button>

        <div class="menu-notificacoes" id="menuNotificacoes">
            <div class="notificacoes-cabecalho">
                <strong>Notificações</strong>
                <button type="button" id="marcarTodasLidas" title="Marcar todas como lidas" aria-label="Marcar todas como lidas">
                    <i class="bi bi-check2-all"></i>
                </button>
            </div>
            <div class="notificacoes-lista" id="listaNotificacoes">
                <p class="notificacoes-vazio">Nenhuma notificação por enquanto.</p>
            </div>
        </div>
    </div>

    <div class="botaosair">
           <a href="/logout" class="btn btn-outline">Sair</a>
           </div>
</div>
</div>
</header>

<script src="/js/headerLogado.js"></script>
