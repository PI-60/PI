
<link rel="stylesheet" href="/css/styleUsuario.css">
<script src="/js/listaUsuario.js" defer></script>

<main class="usuarios-page">

    
    <aside class="sidebar">
        <div class="sidebar-top">
            <span class="sidebar-brand">IFSC60+</span>
        </div>

        <nav class="sidebar-nav">
            <a href="/inicioLogado">Início</a>
            <a href="/dashboard">Dashboard</a>
            <a href="/atividades">Atividades</a>
            <a href="/participantes">Participantes</a>
           <a href="/calendario">Calendário</a>
            <a href="/frequencia">Frequência</a>
            <a href="/galeria">Galeria</a>
            <a href="/usuarios" class="ativo">Usuários</a>
        </nav>

        <div class="sidebar-footer">
            <img src="/assets/60.webp" alt="Logo IFSC 60+">
        </div>
    </aside>


<div id="mensagem" class="mensagem" hidden></div>
    <section class="formulario">

        <h1>Usuários</h1>

        <div class="controles-usuarios">

            <div id="pesquisa">
                <input
                    type="text"
                    id="nome"
                    name="nome"
                    placeholder="Pesquisar por nome ou e-mail"
                    aria-label="Pesquisar por nome ou e-mail"
                >
            </div>

            <div class="filtro-tipo">
                <label for="filtroTipo" class="sr-only">Filtrar por tipo de usuário</label>
                <select id="filtroTipo" name="tipo">
                    <option value="todos">Todos os tipos</option>
                    <option value="administrador">Administrador</option>
                    <option value="coordenador">Coordenador</option>
                    <option value="bolsista">Bolsista</option>
                    <option value="ministrante">Ministrante</option>
                     
                </select>
            </div>

            <button type="button" class="botao-cadastrar" id="cadastrarUsuario">
    <span aria-hidden="true">＋</span> Cadastrar usuário
</button>

        </div>

        <div class="legenda-funcoes">
            <span><i class="ponto administrador"></i>Administrador</span>
            <span><i class="ponto coordenador"></i>Coordenador</span>
            <span><i class="ponto bolsista"></i>Bolsista</span>
            <span><i class="ponto ministrante"></i>Ministrante</span>
        </div>

        <div class="tabela-container">
            <table class="tabela-usuarios">
                <thead>
                    <tr>
                        <th>Usuário</th>
                        <th>E-mail</th>
                        <th>Tipo de usuário</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody id="lista-usuarios">
                    {{#each usuarios}}
                    <tr
                        class="linha-usuario"
                        data-nome="{{nome}}"
                        data-email="{{email}}"
                        data-funcoes="{{#if administrador}}administrador {{/if}}{{#if coordenador}}coordenador {{/if}}{{#if bolsista}}bolsista {{/if}}{{#if ministrante}}ministrante {{/if}}"
                    >
                        <td class="nome-usuario">{{nome}}</td>
                        <td class="email-usuario">{{email}}</td>

                        <td>
                            <div class="funcoes-usuario">
                                {{#if administrador}}
                                <span class="tag-funcao administrador">Administrador</span>
                                {{/if}}

                                {{#if coordenador}}
                                <span class="tag-funcao coordenador">Coordenador</span>
                                {{/if}}

                                {{#if bolsista}}
                                <span class="tag-funcao bolsista">Bolsista</span>
                                {{/if}}

                                {{#if ministrante}}
                                <span class="tag-funcao ministrante">Ministrante</span>
                                {{/if}}

                                {{#unless administrador}}
                                    {{#unless coordenador}}
                                        {{#unless bolsista}}
                                            {{#unless ministrante}}
                                            <span class="tag-funcao participante">Participante</span>
                                            {{/unless}}
                                        {{/unless}}
                                    {{/unless}}
                                {{/unless}}
                            </div>
                        </td>

                        

<td class="acoes-usuario">

    


<td class="acoes-usuario">

    <!-- BOTÃO VISUALIZAR + POP-UP -->
    <div class="visualizar-container">
        <button
            type="button"
            class="botao-acao visualizar"
            title="Visualizar usuário"
            aria-label="Visualizar {{nome}}"
        >
            <svg width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
        </button>

        <div class="popup-usuario" role="tooltip">
            <strong>{{nome}}</strong>

            <span><b>E-mail:</b> {{email}}</span>

            <span>
                <b>Telefone:</b>
                {{#if telefone}}{{telefone}}{{else}}Não informado{{/if}}
            </span>

            {{#unless ministrante}}
                <span>
                    <b>CPF:</b>
                    {{#if CPF}}{{CPF}}{{else}}Não informado{{/if}}
                </span>
            {{/unless}}

            <span><b>Tipo:</b></span>

            <div class="popup-funcoes">
                {{#if administrador}}
                    <span class="tag-funcao administrador">Administrador</span>
                {{/if}}
                {{#if coordenador}}
                    <span class="tag-funcao coordenador">Coordenador</span>
                {{/if}}
                {{#if bolsista}}
                    <span class="tag-funcao bolsista">Bolsista</span>
                {{/if}}
                {{#if ministrante}}
                    <span class="tag-funcao ministrante">Ministrante</span>
                {{/if}}
            </div>
        </div>
    </div>

    <!-- BOTÃO EDITAR -->
    <button
        type="button"
        class="botao-acao editar"
        data-email="{{email}}"
        title="Editar usuário"
        aria-label="Editar {{nome}}"
    >
        <svg width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/>
        </svg>
    </button>

    <!-- BOTÃO EXCLUIR -->
    <button
        type="button"
        class="botao-acao excluir"
        data-email="{{email}}"
        data-ministrante="{{ministrante}}"
        title="Excluir cadastro"
        aria-label="Excluir {{nome}}"
    >
        <svg width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18"/>
            <path d="M8 6V4h8v2"/>
            <path d="M19 6l-1 14H6L5 6"/>
            <path d="M10 11v5"/>
            <path d="M14 11v5"/>
        </svg>
    </button>

</td>


</td>


                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <p id="semresul" style="display:none;">
            Nenhum usuário encontrado.
        </p>

        <div class="paginacao">
            <span id="contador-usuarios">Carregando usuários...</span>
            <div id="botoes-paginacao"></div>
        </div>

    </section>
</main>
