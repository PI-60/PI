<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Atividades</title>
    <link rel="stylesheet" href="/css/styleCadastro.css">
    <script src="/js/cadastroA.js" defer></script>
</head>
<body>
    
<div id="back">
     &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
     <a href="/inicioLogado" style="text-decoration: none;">&lt;</a>
     <!-- alterar link p pagina talvez -->
</div>

<main class="center"> <!-- chama o arquivo ! -->


     <section>
          <!--formulário -->
          <form id="CadastroA" action="/cadastroA" method="post">

    <div class="formulario">

        <h1 id="titulo">Cadastro de Atividades</h1>

        <!-- COLUNA ESQUERDA -->
        <div class="coluna esquerda">

            <div class="campo">
                <label for="tituloA">Título</label>
                <input 
                    type="text" 
                    id="tituloA" 
                    name="tituloA"
                    placeholder="Título da oficina">
            </div>
               <br>
            <div class="campo">
                <label for="emailM">E-mail do ministrante</label>
                <input 
                    type="email" 
                    id="emailM" 
                    placeholder="E-mail do ministrante"
                    name="emailM">
            </div>
               <br>
            <div class="campo">
                <label for="local">Local</label>
                <input 
                    type="text" 
                    id="local"
                    placeholder="Local da atividade" 
                    name="local" 
                    maxlength="1200">
            </div>
               <br>
            <div class="campo">
                <label for="bolsista1">
                    Selecione o bolsista auxiliar dessa atividade
                </label>

                <select id="bolsista1" name="bolsista1">
                    <option value="selecione">Selecione o bolsista</option>
                    <option value="bolsista1">NomeBolsista</option>
                    <option value="bolsista2">NomeBolsista</option>
                    <option value="bolsista3">NomeBolsista</option>
                    <option value="bolsista4">NomeBolsista</option>
                </select>
            </div>
               <br>
            <div class="campo">
                <label for="bolsista2">
                    Selecione o bolsista auxiliar dessa atividade
                </label>

                <select id="bolsista2" name="bolsista2">
                    <option value="selecione">Selecione o bolsista</option>
                    <option value="bolsista1">NomeBolsista</option>
                    <option value="bolsista2">NomeBolsista</option>
                    <option value="bolsista3">NomeBolsista</option>
                    <option value="bolsista4">NomeBolsista</option>
                </select>
            </div>
               <br>
            <div class="campo">
                <label for="bolsista3">
                    Selecione o bolsista auxiliar dessa atividade
                </label>

                <select id="bolsista3" name="bolsista3">
                    <option value="selecione">Selecione o bolsista</option>
                    <option value="bolsista1">NomeBolsista</option>
                    <option value="bolsista2">NomeBolsista</option>
                    <option value="bolsista3">NomeBolsista</option>
                    <option value="bolsista4">NomeBolsista</option>
                </select>
            </div>
          
        </div>


        <!-- COLUNA DIREITA -->
        <div class="coluna direita">

            <div class="campo">
                <label for="descricao">Descrição</label>

                <textarea
                    id="descricao"
                    name="descricao"
                    maxlength="1200"
                    placeholder="Descreva a atividade..."></textarea>
            </div>
               <br>
            <div class="campo">
                <label for="dataInicio">Data de início</label>

                <input 
                    id="dataInicio" 
                    type="date" 
                    name="dataInicio">
            </div>
               <br>
            <div class="campo">
                <label for="dataTermino">Data de término</label>

                <input 
                    type="date" 
                    id="dataTermino" 
                    name="dataTermino">
            </div>
               
        </div>

        <!-- BOTÃO -->
        <button type="submit" class="button">
            Cadastrar
        </button>

    </div>

</form>
          </section>
     </main>
</body>
</html>
