<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Cadastro de Atividades</title>
        <link rel="stylesheet" href="/css/styleCadastroA.css">
        <script src="/js/cadastroA.js" defer></script>

          <a href="{{#if atividade}}/atividade{{else}}/inicioLogado{{/if}}" style="text-decoration: none;">&lt;</a>
    </head>
    <body>

        <div id="back">
            <a href="/atividades" style="text-decoration: none;">&lt;</a>
            <!-- alterar link p pagina talvez -->
        </div>

        <main class="center"> <!-- chama o arquivo ! -->

            <section>
                <!--formulário -->
                <form id="CadastroA" action="/cadastroat" method="post"
                    class="formulario" name="idOficina" >  
                        {{#if atividade}}
                         <input type="hidden"
                          name="idOficina"
                          value="{{atividade.idOficina}}">
                         {{/if}}

                    <h1 id="titulo">Cadastro de Atividades</h1>

                    <!-- COLUNA ESQUERDA -->
                    <div class="coluna esquerda">

                        <div class="campo">
                            <label for="tituloA">Título</label>
                            <input
                                type="text"
                                id="titulo"
                                name="titulo"
                                placeholder="Título da oficina" 
                               value="{{atividade.titulo}}">
                        </div>
                        <br>


                        <!--combox de ministrante-->
                        <div class="campo">
                             <label for="emailM">Selecione o ministrante</label>
                      <select id="emailM" name="emailM" required>
                            <option value="">Selecione o ministrante</option>
                            {{#each ministrante}}
                                <option value="{{this.email}}"
                                 {{#if (eq this.email ../atividade.ministrante_email)}}selected{{/if}}>
                                    {{this.nome}}
                                </option>
                            {{/each}}
                        </select>
                          </div>

                        <br>
                        <div class="campo">
                            <label for="local">Local</label>
                            <input
                                type="text"
                                id="local"
                                placeholder="Local da atividade"
                                name="local"
                                maxlength="1200"
                                value="{{atividade.local}}">
                        </div>

                        
                        <br>
                        <div class="campo">
                            <label for="bolsista1">
                                Selecione o bolsista
                            </label>

                            <!--combox de bolsita-->
                            <select id="bolsista1" name="bolsista1">
                                <option value="selecione">Selecione o
                                    bolsista</option>
                                 {{#each bolsista}}
                                <option value="{{this.email}}"
                                    {{#if (eq this.email ../atividade.bolsista1)}}selected{{/if}}>
                                    {{this.nome}}
                                </option>
                            {{/each}}
                        </select>
                        </div>
                        <br>


                        <div class="campo">
                            <label for="bolsista2">
                                Selecione o bolsista
                            </label>

                            <select id="bolsista2" name="bolsista2" >
                                <option value="selecione">Selecione o
                                    bolsista</option>
                               {{#each bolsista}}
                                <option value="{{this.email}}"
                                    {{#if (eq this.email ../atividade.bolsista2)}}selected{{/if}}>
                                    {{this.nome}}
                                </option>
                            {{/each}}
                        </select>
                        </div>
                        <br>

                        
                      <!-- Bolsista 3 -->
                    <div class="campo">
                        <label for="bolsista3">Selecione o bolsista</label>
                        <select id="bolsista3" name="bolsista3">
                            <option value="selecione">Selecione o bolsista</option>
                            {{#each bolsista}}
                                <option value="{{this.email}}"
                                    {{#if (eq this.email ../atividade.bolsista3)}}selected{{/if}}>
                                    {{this.nome}}
                                </option>
                            {{/each}}
                        </select>
                    </div>

                    <!-- COLUNA DIREITA -->
                    <div class="coluna direita">

                        <div class="campo">
                            <label for="descricao">Descrição</label>

                            <textarea
                                id="descricao"
                                name="descricao"
                                maxlength="1200"
                                placeholder="Descreva a atividade..." > {{atividade.descricao}}</textarea>
                        </div>
                        <br>
                        <div class="campo">
                            <label for="dataInicio">Data de início</label>

                            <input
                                id="dataInicio"
                                type="date"
                                name="dataInicio"
                                 value="{{atividade.dataInicio}}">
                        </div>
                        <br>
                        <div class="campo">
                            <label for="dataTermino">Data de término</label>

                            <input
                                type="date"
                                id="dataTermino"
                                name="dataTermino"
                               value="{{ atividade.dataTermino}}">
                        </div>

                    </div>

                    <!-- BOTÃO -->
                    <button type="submit" class="button">
                           {{#if atividade}}Salvar{{else}}Cadastrar{{/if}} </button>
                    </button>

                </form>
            </section>
        </main>
    </body>
</html>
