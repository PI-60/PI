
<link rel="stylesheet" href="/css/styleCadastro.css">
<script src="/js/cadastroB.js" defer></script>

<div id="back">
    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;

    <a
        href="{{#if editandoUsuario}}/usuarios{{else}}{{#if participante}}/participantes{{else}}/inicioLogado{{/if}}{{/if}}"
        style="text-decoration: none;"
    >&lt;</a>

    <!-- alterar link p pagina talvez -->
</div>

<main class="center {{#if editandoUsuario}}edicao-usuario{{/if}}" data-tipo="{{usuario.tipo}}">
    <!-- chama o arquivo ! -->

    <section>
        <!-- formulário -->
        <form
    id="CadastroB"
    action="{{#if editandoMinistrante}}/usuarios/ministrantes/editar/{{usuario.email}}{{else}}{{#if editandoUsuario}}/usuarios/editar/{{usuario.email}}{{else}}/cadastro{{/if}}{{/if}}"
    method="post"
>
            <!-- quando vem da lista de participantes (editar), guarda o id para a rota fazer UPDATE -->
            {{#if participante}}
                <input
                    type="hidden"
                    name="idParticipante"
                    value="{{participante.idParticipante}}"
                >
            {{/if}}

            <!-- username, telefone, cpf.. -->
            <div class="formulario">

                <h1 id="titulo">
    {{#if editandoMinistrante}}
        Editar ministrante
    {{else}}
        {{#if editandoUsuario}}
            Editar usuário
        {{else}}
            {{#if participante}}
                Editar participante
            {{else}}
                Cadastro de Usuário
            {{/if}}
        {{/if}}
    {{/if}}
</h1>

                <!-- Campos principais ficam visíveis durante a edição -->
                <div
                    id="hidden"
                    {{#if participante}}
                        style="display: contents;"
                    {{else}}
                        {{#if editandoUsuario}}
                            style="display: contents;"
                        {{else}}
                            style="display: none;"
                        {{/if}}
                    {{/if}}
                >

                    <!-- div input (tipo texto, id dos elementos e placeholder) -->
                    <div class="campo esquerda">
                        <label for="nameB">Nome Completo</label>
                        <input
                            type="text"
                            id="nameB"
                            placeholder="Nome Completo"
                            name="nome"
                            value="{{#if editandoUsuario}}{{usuario.nome}}{{else}}{{participante.nome}}{{/if}}"
                            required
                        >
                    </div>

                    <div
                        class="campo esquerda"
                        {{#if participante}}style="display:none;"{{/if}}
                    >
                        <label for="emailB">E-mail</label>
                        <input
                            type="email"
                            id="emailB"
                            placeholder="E-mail"
                            name="email"
                            value="{{#if editandoUsuario}}{{usuario.email}}{{/if}}"
                            {{#if editandoUsuario}}readonly{{/if}}
                        >
                    </div>

                    <div class="campo direita campo-cpf">
                        <label for="cpfB">CPF</label>
                        <input
                            type="text"
                            id="cpfB"
                            maxlength="14"
                            placeholder="000.000.000-00"
                            name="cpf"
                            value="{{#if editandoUsuario}}{{usuario.CPF}}{{else}}{{participante.CPF}}{{/if}}"
                        >
                    </div>

                    <div class="campo esquerda">
                        <label for="phoneB">Telefone</label>
                        <input
                            type="tel"
                            id="phoneB"
                            placeholder="(99) 99999-9999"
                            maxlength="15"
                            name="telefone"
                            value="{{#if editandoUsuario}}{{usuario.telefone}}{{else}}{{participante.telefone}}{{/if}}"
                        >
                    </div>

                </div>

                <!-- aparece só quando escolher bolsista = JS -->
                {{#unless editandoUsuario}}
                    <div
                        class="campo direita"
                        {{#if participante}}style="display:none;"{{/if}}
                    >
                        <label for="passwordB">Senha</label>
                        <input
                            id="passwordB"
                            type="password"
                            placeholder="Senha"
                            name="senha"
                        >
                    </div>

                    <div
                        class="campo direita"
                        {{#if participante}}style="display:none;"{{/if}}
                    >
                        <label for="siape">SIAPE</label>
                        <input
                            type="text"
                            id="siape"
                            name="siape"
                            placeholder="SIAPE"
                        >
                    </div>

                    <div class="campo esquerda">
                        <label for="tipoU">Tipo de Usuário</label>

                        {{#if participante}}
                            <input
                                type="hidden"
                                name="tipo"
                                value="participante"
                            >
                        {{/if}}

                        <select
                            id="tipoU"
                            class="select"
                            name="tipo"
                            {{#if participante}}disabled{{/if}}
                        >
                            <option value="usuario">Selecione o tipo de Usuário</option>
                            <option value="bolsista">Bolsista</option>
                            <option value="participante" {{#if participante}}selected{{/if}}>
                                Participante
                            </option>
                            <option value="ministrante">Ministrante</option>
                            <option value="coordenador">Coordenador</option>
                        </select>
                    </div>
                {{else}}
                    <!-- Na edição de usuário, o tipo atual é exibido sem permitir alteração -->
                    
<div class="campo esquerda campo-tipo">
    <label for="tipoAtual">Tipo de Usuário</label>
    <select id="tipoAtual" class="select" disabled>
        <option selected>{{usuario.tipo}}</option>
    </select>
</div>

                {{/unless}}

                <!-- botão de cadastro, tipo submit (form) -->
                <button type="submit" class="button">
                    {{#if editandoUsuario}}
                        Salvar alterações
                    {{else}}
                        {{#if participante}}
                              Salvar alterações
                        {{else}}
                            Cadastrar
                        {{/if}}
                    {{/if}}
                </button>

            </div>
        </form>
    </section>
</main>
