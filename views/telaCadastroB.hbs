<link rel="stylesheet" href="/style.css">

<main class="center"> <!-- chama o arquivo ! -->


        <section>
            <h1>Cadastro de Bolsista</h1>

            <form id="CadastroB">
                <div class="formulario">
                    
                    <div class="campo">
                        <label for="nameB">Nome Completo</label>
                        <input type="text" id="nameB" placeholder="Nome Completo" required>
                    </div>

                    <div class="campo">
                        <label for="emailB">E-mail</label>
                        <input type="email" id="emailB" placeholder="E-mail" required>
                    </div>

                    <div class="campo">
                        <label for="cpfB">CPF</label>
                        <input type="text" id="cpfB" placeholder="CPF" required>
                    </div>

                    <div class="campo">
                        <label for="phoneB">Telefone</label>
                        <input type="text" id="phoneB" placeholder="Telefone" required>
                    </div>

                    <div class="campo campo-full">
                        <label for="selectB">Tipo de Cadastro</label>
                        <select id="selectB" class="select" required>
                            <option value="">Selecione...</option>
                            <option value="1">Participante</option>
                            <option value="2">Ministrante</option>
                            <option value="3">Coordenador</option>
                        </select>
                    </div>

                </div>

                <button type="submit" class="button">Cadastrar</button>
            </form>
        </section>
    </main>



