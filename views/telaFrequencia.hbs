<link rel="stylesheet" href="/css/styleFrequencia.css">
<script src="/js/frequencia.js" defer></script>




<main class="app-shell">
<aside class="sidebar">
      <div class="sidebar-top">
        </button>
        <span class="sidebar-brand">IFSC60+</span>
      </div>

      <nav class="sidebar-nav">
        <a href="/inicioLogado">Início</a>
       
        <a href="/atividades" class="active">Atividades</a>
        <a href="/participantes">Participantes</a>
    
        <a href="/frequencia">Frequência</a>
         <a href="/usuarios" class="ativo">Usuários</a>

      </nav>

      <div class="sidebar-footer">
        <img src="/assets/60.webp" alt="Logo IFSC 60+">
      </div>
    </aside>

            <div id="mensagem" class="mensagem" hidden></div>

        <div class="page-content">
        <form id="Frequencia" class="formulario" method="POST" action="/frequencia">

                <h1 id="titulo">Frequência</h1>

                <!-- Escolha da oficina -->

                    <div class="filtrofreq">
                             <div class="campo-frequencia">
                            <label for="oficina">Oficina</label>
                          <select id="oficina" name="oficina">
                            <option value="">Selecione a atividade e o dia</option>
                            {{#each opcoes}}
                                 <option value="{{this.valor}}" {{#if this.lancada}}disabled{{/if}}>{{this.rotulo}}</option>
                            {{/each}}
                            </select>

                        <!-- pesquisa os participantes -->
                        <label for="pesquisa-frequencia">Pesquisar participantes</label>
              <input type="text" id="pesquisa-frequencia" placeholder="Pesquisar participante...">
              <br>

                <!-- Cabeçalho da lista -->
                <div id="listaf">
                <div class="cabecalho-frequencia">
                    <span>Participante</span>
                    <span>Frequência</span>
                </div>

               <!-- Participantes vindos do banco -->
                   <div id="linhas-frequencia">
                    {{#each participantes}}
                        <div class="linha-participante linha-frequencia" data-id="{{this.idParticipante}}">
                        <span class="nome-participante">{{this.nome}}</span>
                        <select class="select-frequencia presenca">
                            <option value="presenca">Presença</option>
                            <option value="falta">Falta</option>
                        </select>
                        </div>
                    {{/each}}
                    </div>
                     </div>


             <div class="paginacao">

            <p id="semresul">Selecione a oficina e a data.</p>
         

            <div id="contador-participantes"></div>
            <div id="botoes-paginacao"></div>

            </div>

                <div class="acoes-frequencia">
                    <button  id="button"  type="submit" class="botaofreq">
                        SALVAR
                    </button>

                    <button type="button" class="botao-planilha" id="abrirPlanilha"
                        title="Ver planilha de frequência" aria-label="Ver planilha de frequência">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>


        </form>

<!-- Modal da planilha de frequência (preenchida pelo frequencia.js) -->
<div class="modal-planilha" id="modalPlanilha" aria-hidden="true">
    <div class="modal-planilha-conteudo" role="dialog" aria-modal="true" aria-labelledby="tituloPlanilha">

        <div class="modal-planilha-topo">
            <div>
                <h2 id="tituloPlanilha">Planilha de Frequência</h2>
                <p class="modal-planilha-sub">Presença dos participantes em cada atividade</p>
            </div>
            <button type="button" class="modal-planilha-fechar" id="fecharPlanilha" aria-label="Fechar">✕</button>
        </div>

        <div class="planilha-legenda">
            <span><i class="legenda-cor presente"></i> Presente</span>
            <span><i class="legenda-cor ausente"></i> Sem presença</span>
        </div>

        <div id="planilhaCorpo">
            <p class="planilha-vazia">Carregando...</p>
        </div>

    </div>
</div>
       
    

</main>