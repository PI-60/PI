<link rel="stylesheet" href="/css/styleFrequencia.css">
<script src="/js/frequencia.js" defer></script>




<main class="app-shell">
<aside class="sidebar">
      <div class="sidebar-top">
        </button>
        <span class="sidebar-brand">IFSC60+</span>
      </div>

      <nav class="sidebar-nav">
        <a href="/inicioLogado">Início</a>
       
        <a href="/atividades" class="active">Atividades</a>
        <a href="/participantes">Participantes</a>
    
        <a href="/frequencia">Frequência</a>
         <a href="/usuarios" class="ativo">Usuários</a>

      </nav>

      <div class="sidebar-footer">
        <img src="/assets/60.webp" alt="Logo IFSC 60+">
      </div>
    </aside>

            <div id="mensagem" class="mensagem" hidden></div>

        <div class="page-content">
        <form id="Frequencia" class="formulario">

                <h1 id="titulo">Aferir Frequência</h1>

                <!-- Escolha da oficina -->

                    <div class="filtrofreq">
                             <div class="campo-frequencia">
                            <label for="oficina">Oficina</label>
                           <select id="selectDia" name="dia">
                            <option value="">Selecione a atividade e o dia</option>
                            {{#each opcoes}}
                                <option value="{{this.valor}}">{{this.rotulo}}</option>
                            {{/each}}
                            </select>

                        <!-- pesquisa os participantes -->
                <input type="text" id="pesquisa" placeholder="Pesquisar participante...">

                <!-- Cabeçalho da lista -->
                <div id="listaf">
                <div class="cabecalho-frequencia">
                    <span>Participante</span>
                    <span>Frequência</span>
                </div>

               <!-- Participantes vindos do banco -->
                        <div class="linha-participante">  
                    <select class="select-frequencia presenca" onchange="mudarCor(this)"  name="frequencia[{{idParticipante}}]">
                    <option value="presenca">Presente</option>
                    <option value="falta">Faltou</option>
                </select>
                    </div>
            </div>

             <div id="linhas-frequencia"></div>

            <p id="semresul">Selecione a oficina e a data.</p>
            </div>

            <div id="contador-participantes"></div>
            <div id="botoes-paginacao"></div>

                <button type="submit" class="botaofreq">
                    SALVAR
                </button>


        </form>
       
    

</main>