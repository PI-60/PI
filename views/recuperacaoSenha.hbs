<link rel="stylesheet" href="/css/styleRecSenha.css">
<!-- use  se o arquivo styleRecSenha.css para definir a aparência desta página -->

<main class="center">
    <!-- uapresneta o conteudo da pagina -->
    

    <section>

        

        <form id="RecuperacaoSenha" method="post" action="/recuperacao-senha">

                 <!-- formulário não está explicitamente configurado para enviar um POST para /recuperacao-senha -->

            <div class="formulario-recuperacao">

               <h1  >Recuperação de Senha</h1>

                {{#if mensagem}}<p class="aviso sucesso">{{mensagem}}</p>{{/if}}
                {{#if erro}}<p class="aviso erro">{{erro}}</p>{{/if}}

                <div class="campo">
                    <label for="email">E-mail</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="E-mail"
                        required
                    >
                </div>

                <!-- envia o formulário -->
                <button type="submit" class="button">
                    Recuperar Senha

                    
                </button>

            </div>

        </form>

    </section>

</main>